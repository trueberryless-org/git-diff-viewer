---
import DiffForm from "../components/DiffForm.astro";
import Layout from "../layouts/Layout.astro";
import { loadDiffPage } from "../libs/diff-page";

import DiffExplorer from "../components/DiffExplorer.vue";

const page = await loadDiffPage(Astro.url.searchParams);

if (page.type === "form") {
  Astro.response.status = page.status;
  if (Astro.cache.enabled) Astro.cache.set(false);
}

const editUrl = `/${Astro.url.search}`;
---

{page.type === "diff" ? (
  <Layout title={page.params.file} wide>
    <div class="gdv-summary">
      <a class="gdv-repo" href={page.links.repo}>
        {page.params.repo}
      </a>
      <h1>
        <a href={page.links.file}>{page.params.file}</a>
      </h1>
      <p class="gdv-meta">
        <span>
          Changes since{" "}
          <time datetime={page.params.sinceTimestamp}>{page.params.since}</time>
        </span>
        <span>
          {page.history.commits.length}
          {page.history.hasMoreCommits ? "+" : ""}
          {page.history.commits.length === 1 ? " commit" : " commits"}
        </span>
        {page.links.compare && (
          <a href={page.links.compare}>Compare on GitHub</a>
        )}
        <a href={editUrl}>Edit query</a>
      </p>
    </div>
    {page.history.commits.length > 0 ? (
      <DiffExplorer
        client:only="vue"
        commits={page.history.commits}
        file={page.params.file}
        hasMoreCommits={page.history.hasMoreCommits}
        newContent={page.history.newContent}
        oldContent={page.history.oldContent}
        repo={page.params.repo}
        sideBySide={page.params.sideBySide}
      >
        <p slot="fallback" class="gdv-loading">
          Loading diff…
        </p>
      </DiffExplorer>
    ) : (
      <p class="gdv-empty">This file has not changed since that date.</p>
    )}
  </Layout>
) : (
  <Layout>
    <h1>Show a diff</h1>
    <DiffForm error={page.error} values={page.values} />
  </Layout>
)}

<style>
  h1 {
    margin: 0.125rem 0 0.375rem;
    font-size: 1.25rem;
    font-family: var(--gdv-font-mono);
    word-break: break-all;
  }

  h1 a {
    color: inherit;
  }

  .gdv-summary {
    margin-block-end: 0.5rem;
  }

  .gdv-repo {
    color: var(--gdv-muted);
  }

  .gdv-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    color: var(--gdv-muted);
  }

  .gdv-loading,
  .gdv-empty {
    margin-block: 1.5rem;
    color: var(--gdv-muted);
  }
</style>
