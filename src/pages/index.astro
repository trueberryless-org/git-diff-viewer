---
import DiffForm from "../components/DiffForm.astro";
import Layout from "../layouts/Layout.astro";
import { getDiffFormValues } from "../libs/params";

const values = getDiffFormValues(Astro.url.searchParams);
---

<Layout>
  <h1>See what changed in a file</h1>
  <p class="gdv-intro">
    Compare a file in a public GitHub repository with its version from a
    specific date, and browse every commit that changed it since.
  </p>
  <DiffForm values={values} />
</Layout>

<style>
  h1 {
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
  }

  .gdv-intro {
    margin: 0 0 2rem;
    color: var(--gdv-muted);
  }
</style>
